# Chatbot Service Configurations
PORT=3001
NODE_ENV=development

# Database (Prisma defaults to PostgreSQL)
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=chatbot"
DATABASE_URL="mysql://root:password@localhost:3306/chatbot"

# Redis Cache and Queues
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="your-jwt-secret-key"

# AI Integrations
OPENAI_API_KEY="your-openai-api-key"
AI_MODEL="gpt-4o"
